---
/**
 * The sky layer shared by every scene: gradient, sun (or moon), stars, a meteor, clouds and birds,
 * plus the <symbol> sprite the destination layers reuse. Colours come from the time-of-day tokens.
 */
import { stars } from "../../lib/shapes";

interface Props {
  /** extra sky above y=0, as passed to Scene */
  sky: number;
}
const { sky } = Astro.props;
const field = stars(7, 80, 330 + sky, -sky);
const clouds = [
  { y: -60, s: 0.8, dur: 160, delay: -90 },
  { y: 70, s: 1.1, dur: 140, delay: -20 },
  { y: 150, s: 0.7, dur: 110, delay: -70 },
  { y: 40, s: 0.55, dur: 170, delay: -120 },
  { y: 200, s: 0.9, dur: 125, delay: -5 },
];
const flocks = [
  { y: 120, s: 1, dur: 48, delay: -8 },
  { y: 210, s: 0.7, dur: 66, delay: -35 },
];
---

<defs>
  <linearGradient id="sky" gradientUnits="userSpaceOnUse" x1="0" y1={-sky} x2="0" y2="560">
    <stop offset="0" style="stop-color: var(--sky-top)"></stop>
    <stop offset="0.55" style="stop-color: var(--sky-mid)"></stop>
    <stop offset="1" style="stop-color: var(--sky-bot)"></stop>
  </linearGradient>
  <radialGradient id="glow">
    <stop offset="0" style="stop-color: var(--sun-glow); stop-opacity: 0.85"></stop>
    <stop offset="1" style="stop-color: var(--sun-glow); stop-opacity: 0"></stop>
  </radialGradient>
  <radialGradient id="lamp">
    <stop offset="0" stop-color="#ffd27a" stop-opacity="0.9"></stop>
    <stop offset="1" stop-color="#ffd27a" stop-opacity="0"></stop>
  </radialGradient>
  <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" style="stop-color: var(--water-hi)"></stop>
    <stop offset="0.35" style="stop-color: var(--water)"></stop>
    <stop offset="1" style="stop-color: var(--water)"></stop>
  </linearGradient>

  <pattern id="streaks" width="14" height="60" patternUnits="userSpaceOnUse">
    <path d="M3 0 V38 M10 14 V60" stroke="#000" stroke-opacity="0.08" stroke-width="2"></path>
  </pattern>

  <symbol id="cloud" viewBox="0 0 220 80">
    <path
      d="M24 70 C4 70 2 46 22 42 C20 22 46 12 62 26 C70 6 104 0 118 22 C132 10 160 14 162 36 C186 30 210 44 200 62 C204 70 196 72 186 72 Z"
    ></path>
  </symbol>
  <symbol id="bird" viewBox="0 0 24 10">
    <path d="M0 6 Q6 0 12 6 Q18 0 24 6" fill="none" stroke-width="1.8" stroke-linecap="round" style="stroke: var(--bird)"
    ></path>
  </symbol>
  <symbol id="palm" viewBox="0 0 120 220" overflow="visible">
    <path d="M58 220 C60 160 64 110 74 60" fill="none" stroke-width="7" stroke-linecap="round" style="stroke: var(--wood)"
    ></path>
    <g style="fill: var(--hill-near)">
      <path d="M74 60 C50 40 22 44 4 62 C26 50 50 52 74 62Z"></path>
      <path d="M74 60 C60 30 34 18 12 22 C36 30 56 42 74 62Z"></path>
      <path d="M74 60 C84 30 106 20 120 24 C102 34 88 46 76 62Z"></path>
      <path d="M74 60 C98 48 116 60 120 80 C104 66 90 62 74 62Z"></path>
      <path d="M74 60 C74 34 82 14 96 4 C88 24 82 42 76 62Z"></path>
    </g>
  </symbol>
  <symbol id="plane" viewBox="0 0 40 14">
    <path d="M2 7 L30 5 Q38 5 39 7 Q38 9 30 9 L2 7Z M14 6 L20 0 L24 0 L20 6Z M14 8 L20 14 L24 14 L20 8Z M2 7 L0 3 L4 3 L7 6Z"
    ></path>
  </symbol>
</defs>

<rect y={-sky} width="1600" height={600 + sky} fill="url(#sky)"></rect>

<g class="stars" aria-hidden="true">
  {
    field.map((s) => (
      <circle cx={s.x} cy={s.y} r={s.r} style={`--d:${s.d}s`} />
    ))
  }
  <path class="meteor" d="M0 0 L120 40" stroke-width="2" stroke-linecap="round"></path>
</g>

<g class="sun">
  <circle r="150" fill="url(#glow)"></circle>
  <circle r="46" class="disc"></circle>
  <circle r="46" class="moon-shade" cx="18" cy="-10"></circle>
</g>

<g class="clouds">
  {
    clouds.map((c) => (
      <use
        href="#cloud"
        width={220 * c.s}
        height={80 * c.s}
        y={c.y}
        style={`--dur:${c.dur}s; --delay:${c.delay}s`}
      />
    ))
  }
</g>

<g class="birds">
  {
    flocks.map((f) => (
      <g class="flock" style={`--dur:${f.dur}s; --delay:${f.delay}s`}>
        <use href="#bird" x="0" y={f.y} width={24 * f.s} height={10 * f.s} />
        <use href="#bird" x={22 * f.s} y={f.y + 10 * f.s} width={20 * f.s} height={9 * f.s} />
        <use href="#bird" x={-18 * f.s} y={f.y + 14 * f.s} width={18 * f.s} height={8 * f.s} />
      </g>
    ))
  }
</g>
