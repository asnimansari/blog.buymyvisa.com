---
/** Krabi / Phi Phi: karst towers rising out of a turquoise bay, a long-tail boat, palms on the beach. */
import { ridge, rolling } from "../../lib/shapes";
import Karst from "./Karst.astro";

const farTowers = [
  { x: 120, base: 470, w: 110, h: 210, lean: 6 },
  { x: 250, base: 470, w: 70, h: 150 },
  { x: 880, base: 470, w: 120, h: 240, lean: -8 },
  { x: 1010, base: 470, w: 80, h: 170 },
  { x: 1380, base: 470, w: 140, h: 230, lean: 10 },
];
const midTowers = [{ x: 520, base: 478, w: 150, h: 290, lean: 10 }, { x: 660, base: 478, w: 90, h: 190, lean: -6 }, { x: 1180, base: 478, w: 120, h: 260 }];
const beach = ridge([
  [-40, 540],
  [200, 528],
  [460, 548],
  [800, 556],
  [1200, 540],
  [1640, 520],
]);
---

<g class="layer layer-far">
  <path class="far" d={rolling(11, 7, 470, 430)}></path>
  {farTowers.map((k) => <Karst {...k} far />)}
</g>

<rect class="sea" x="0" y="460" width="1600" height="140"></rect>
<g aria-hidden="true">
  <path class="shimmer" d="M60 490 H520 M700 506 H1200 M240 522 H760 M1050 530 H1540"></path>
</g>

<g class="layer layer-mid">
  {midTowers.map((k) => <Karst {...k} />)}
</g>

<g class="sail-across" style="--dur:120s; --delay:-50s">
  <g transform="translate(0 500)"><g class="bob">
    <path class="wood" d="M0 0 L150 0 Q170 -2 190 -26 L196 -24 Q182 6 160 14 L20 14 Q6 12 0 0Z"></path>
    <path class="sail" d="M180 -22 L192 -40 L196 -24Z"></path>
    <rect x="40" y="-26" width="70" height="4" rx="2" class="wood"></rect>
    <rect x="44" y="-22" width="3" height="22" class="wood"></rect>
    <rect x="104" y="-22" width="3" height="22" class="wood"></rect>
    <circle class="halo" cx="76" cy="-14" r="28"></circle>
    <circle class="light" cx="76" cy="-14" r="3"></circle>
  </g></g>
</g>

<g class="layer layer-near">
  <path class="sand" d={beach}></path>
  <use href="#palm" class="palm" x="40" y="330" width="140" height="220"></use>
  <use href="#palm" class="palm" x="150" y="380" width="100" height="160" style="animation-delay:-2s"></use>
  <use href="#palm" class="palm" x="1420" y="320" width="150" height="230" style="animation-delay:-4s"></use>
</g>
