---
/** Ha Long Bay at the back, a red-sailed junk, rice terraces in front and lanterns that light up at night. */
import { ridge } from "../../lib/shapes";
import Karst from "./Karst.astro";

const far = [
  { x: 40, base: 452, w: 90, h: 120 },
  { x: 170, base: 452, w: 60, h: 90 },
  { x: 330, base: 452, w: 110, h: 150, lean: 6 },
  { x: 700, base: 452, w: 80, h: 110 },
  { x: 980, base: 452, w: 120, h: 160, lean: -6 },
  { x: 1150, base: 452, w: 70, h: 100 },
  { x: 1300, base: 452, w: 90, h: 130 },
  { x: 1480, base: 452, w: 100, h: 140 },
];
const mid = [{ x: 470, base: 470, w: 130, h: 210, lean: 8 }, { x: 820, base: 470, w: 100, h: 170, lean: -4 }, { x: 1210, base: 470, w: 110, h: 190 }];
const terraces = Array.from({ length: 5 }, (_, i) =>
  ridge(
    [
      [860, 520 + i * 18],
      [1100, 480 + i * 22],
      [1350, 470 + i * 20],
      [1640, 460 + i * 22],
    ],
    600,
  ),
);
const lanterns = [
  { x: 150, y: 140, c: "#d8452f" },
  { x: 240, y: 160, c: "#f0a12b" },
  { x: 330, y: 150, c: "#d8452f" },
  { x: 420, y: 128, c: "#3d8f6b" },
];
---

<g class="layer layer-far">
  {far.map((k) => <Karst {...k} far />)}
</g>
<rect class="sea" x="0" y="448" width="1600" height="152"></rect>
<path class="shimmer" d="M30 480 H400 M560 496 H880 M180 512 H620 M960 470 H1200"></path>

<g class="layer layer-mid">
  {mid.map((k) => <Karst {...k} />)}
</g>

<g class="sail-across" style="--dur:140s; --delay:-30s">
  <g transform="translate(0 492)"><g class="bob">
    <path class="wood" d="M0 0 H120 Q130 0 136 -10 L140 -8 Q132 14 116 16 H18 Q4 14 0 0Z"></path>
    <path class="sail" d="M30 -4 Q22 -40 34 -78 L64 -74 Q56 -40 62 -4Z"></path>
    <path class="sail" d="M72 -4 Q66 -34 76 -64 L100 -60 Q94 -32 98 -4Z"></path>
    <circle class="halo" cx="60" cy="-6" r="26"></circle>
  </g></g>
</g>

<g class="layer layer-near">
  {terraces.map((d, i) => <path class={i % 2 ? "near" : "mid"} d={d} />)}
  <path class="ground" d="M-40 600 L-40 548 C120 530 300 556 520 566 C640 572 760 580 900 600 Z"></path>
  <path
    d="M110 118 Q280 170 460 112"
    fill="none"
    stroke="var(--ink)"
    stroke-width="1.5"
    opacity="0.5"></path>
  {
    lanterns.map((l) => (
      <g transform={`translate(${l.x} ${l.y})`}>
        <g class="lantern">
        <circle class="halo" r="36" />
        <line y1="-16" y2="-6" stroke="var(--ink)" stroke-width="1.5" />
        <ellipse rx="12" ry="16" cy="10" fill={l.c} />
        <rect x="-6" y="-8" width="12" height="4" fill="var(--ink)" />
        <rect x="-6" y="24" width="12" height="4" fill="var(--ink)" />
        </g>
      </g>
    ))
  }
</g>

<style>
  .lantern {
    animation: sway 5s ease-in-out infinite alternate;
    transform-box: fill-box;
    transform-origin: 50% 0;
  }
</style>
