---
import { DEFAULT_DESCRIPTION, SITE_NAME, absolute } from "../../lib/seo";

interface Props {
  title: string;
  description?: string | undefined;
  /** social card: an absolute URL, ideally 1200×630 (the default card's size) */
  image?: { src: string; width: number; height: number; alt: string } | undefined;
  type?: "website" | "article" | undefined;
  publishedAt?: Date | undefined;
  updatedAt?: Date | undefined;
  /** JSON-LD objects, rendered as one script each */
  jsonLd?: object[] | undefined;
  noindex?: boolean | undefined;
}

const { title, description = DEFAULT_DESCRIPTION, image, type = "website", publishedAt, updatedAt, jsonLd = [], noindex } =
  Astro.props;
const canonical = absolute(Astro.url.pathname, Astro.site);
// Google cuts titles at about 60 characters; long guide titles go without the site name rather than lose their end.
const suffixed = `${title} | ${SITE_NAME}`;
const fullTitle = title === SITE_NAME || suffixed.length > 60 ? title : suffixed;
const ogImage = image ?? {
  src: absolute(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/og-default.jpg`, Astro.site),
  width: 1200,
  height: 630,
  alt: "An illustrated landscape at dusk: layered hills under a gradient sky",
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large"} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_IN" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage.src} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={ogImage.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.src} />
<meta name="twitter:image:alt" content={ogImage.alt} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />)}
