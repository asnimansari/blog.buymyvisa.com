---
import { DEFAULT_DESCRIPTION, SITE_NAME, absolute } from "../../lib/seo";

interface Props {
  title: string;
  description?: string | undefined;
  /** absolute image URL for social cards */
  image?: string | undefined;
  type?: "website" | "article" | undefined;
  publishedAt?: Date | undefined;
  updatedAt?: Date | undefined;
  /** JSON-LD objects, rendered as one script each */
  jsonLd?: object[] | undefined;
  noindex?: boolean | undefined;
}

const { title, description = DEFAULT_DESCRIPTION, image, type = "website", publishedAt, updatedAt, jsonLd = [], noindex } =
  Astro.props;
const canonical = absolute(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const ogImage = image ?? absolute(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/og-default.jpg`, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="en_IN" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />)}
